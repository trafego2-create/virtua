# Copie para .env (local) ou cadastre no EasyPanel → app → Environment.
# Nenhum valor real vai para o git.

# Supabase → Project Settings → Database → Connection string (pooler, modo session)
DATABASE_URL=

# Endereço público do site (https://... em produção)
PUBLIC_URL=

# Assina o cookie de login. Gerar: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=
